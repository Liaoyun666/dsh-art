{
  "name": "dsh-anim-pack",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "代码动画素材包：341 种风格提示词 / 193 张参考静帧 / 244 条像素特效（pixelfx）+ 远端美术参考图库，共 18 个 anim_* 工具，检索、看图、导出、接入游戏一次到位。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js",
    "./fx": "./lib/fx.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "assets/",
    "docs/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "cordis": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
